{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",

    "palette": {
        "blue": "#8AADF4",
        "lavender": "#B7BDF8",
        "yellow": "#E5C890",
        "os": "#ACB0BE",
        "pink": "#F5BDE6",
        "red": "#E78284",
        "flamingo": "#F0C6C6",
        "rosewater": "#F4DBD6",
        "sapphire": "#7DC4E4",
        "sky": "#91D7E3",
        "text": "#494D64",
        "wight": "#FFFFFF"
    },

    "transient_prompt": {
        "template": "{{ .Shell }}> ",
        "foreground": "#ffffff",
        "background": "transparent"
    },

    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [

                {
                    "properties": {
                        "cache_duration": "none"
                    },
                    "leading_diamond": "\ue0b6",
                    "template": "{{.Icon}}",
                    "foreground": "p:wight",
                    "powerline_symbol": "\ue0b4",
                    "background": "p:blue",
                    "type": "os",
                    "style": "diamond"
                },
                
                {
                    "properties": {
                        "cache_duration": "none"
                    },
                    "template": "{{ if .SSHSession }} {{ .UserName }}@{{ .HostName }} {{ end }}",
                    "foreground": "p:text",
                    "powerline_symbol": "\ue0b4",
                    "background": "p:blue",
                    "type": "session",
                    "style": "diamond"
                },
                
                {
                    "properties": {
                        "cache_duration": "none",
                        "folder_icon": "...",
                        "home_icon": "~",
                        "style": "agnoster_short",
                        "max_depth": 4
                    },
                    "template": " {{ .Path }}",
                    "foreground": "p:text",
                    "powerline_symbol": "\ue0b4",
                    "background": "p:pink",
                    "type": "path",
                    "style": "powerline"
                },

                {
                    "properties": {
                        "branch_icon": "\ue725 ",
                        "cache_duration": "none",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "fetch_status": false,
                        "fetch_upstream_icon": false,
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    },
                    "template": " {{ .HEAD }}",
                    "foreground": "p:text",
                    "powerline_symbol": "\ue0b4",
                    "background": "p:lavender",
                    "type": "git",
                    "style": "powerline"
                },

		{
		    "type": "python",
                    "style": "powerline",
                    "foreground": "p:text",
                    "background": "p:yellow",
                    "powerline_symbol": "\ue0b4",
		    "display_mode": "environment",
                    "template": "  {{ .Venv }}"
		},

                {
                    "type": "nix-shell",
                    "style": "powerline",
                    "foreground": "p:text",
                    "background": "p:sky",
                    "powerline_symbol": "\ue0b4",
                    "template": " \uF313 nix-shell"
                }
            ]
        },

        {
            "type": "prompt",
            "alignment": "right",
            "segments": [
                {
                    "type": "status",
                    "style": "powerline",
                    "foreground": "p:text",
                    "background": "p:red",
                    "leading_powerline_symbol": "\ue0b6",
                    "powerline_symbol": "\ue0b4"
                },

                {
                    "type": "executiontime",
                    "style": "powerline",
                    "foreground": "p:text",
                    "background": "p:yellow",
                    "leading_powerline_symbol": "\ue0b6",
                    "powerline_symbol": "\ue0b4",
                    "template": " {{ .FormattedMs }}",
                    
                    "properties": {
                        // "always_enabled": true,
                        "style": "roundrock",
                        "threshold": 500
                    }
                },

                {
                    "type": "root",
                    "style": "powerline",
                    "powerline_symbol": "\ue0b4",
                    "foreground": "p:text",
                    "background": "p:yellow"
                }
            ]
        },

        {
            "type": "prompt",
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "text",
                    "style": "plain",
                    "template": "➤"
                    // "template": "\n\u2514\u2500"
                }
            ]
        }

    ],
    "version": 3,
    "final_space": true
}
